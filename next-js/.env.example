# Copy to .env.local for local work. Server-only unless prefixed NEXT_PUBLIC_.

# Absolute base of the theme's read API. Required (unless MOCK_API=1).
WP_API_BASE=https://progressnow.test:8890/wp-json/progressnow/v1
# WordPress origin for media, theme static assets (fonts) and link re-homing.
# Derived from WP_API_BASE when unset.
# WP_ORIGIN=https://progressnow.test:8890

# Public origin of this app — sitemap, robots, absolute Open Graph URLs.
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3001

# Shared HMAC secret for the WordPress rebuild webhook (CHAPTER_REBUILD_SECRET
# in wp-config.php). Required (unless MOCK_API=1).
CHAPTER_REBUILD_SECRET=
# Optional: WordPress build-status callback; the receiver reports "succeeded".
# WP_BUILD_STATUS_URL=https://progressnow.test:8890/wp-json/progressnow/v1/build-status

# Comma-separated hosts allowed for next/image (default: the WP_ORIGIN host).
# IMAGE_HOSTS=progressnow.test

# Fixture-backed mock API (dev/e2e): relaxes the secret and points WP_API_BASE
# at test/mock/server.mjs. `npm run dev:mock` sets this for you.
# MOCK_API=1

# Local self-signed MAMP certificate: let server fetches talk to it.
# NODE_TLS_REJECT_UNAUTHORIZED=0
