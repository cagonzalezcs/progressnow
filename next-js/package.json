{
  "name": "progressnow-next",
  "private": true,
  "version": "0.1.0",
  "description": "Headless Next.js frontend for the Progress Now WordPress theme (reads /wp-json/progressnow/v1).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "dev:mock": "node scripts/dev-mock.mjs",
    "mock": "node test/mock/server.mjs",
    "build": "next build",
    "budget": "playwright test --project=e2e test/e2e/budget.spec.ts",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=e2e",
    "test:a11y": "playwright test --project=a11y",
    "start:standalone": "node scripts/start-standalone.mjs",
    "build:mock": "node scripts/build-with-mock.mjs",
    "test:failure": "playwright test --project=failure --workers=1",
    "parity": "node scripts/parity-screenshots.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.5",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.12.3",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.0",
    "axe-core": "4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jest-axe": "^11.0.0",
    "jsdom": "^29.0.0",
    "prettier": "3.8.3",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vite": "^7.3.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "jest-axe": {
      "axe-core": "4.13.0"
    }
  }
}
