# Copy to .env for local work. `nuxt dev` proxies /wp-json and /wp-content to
# NUXT_DEV_WP_ORIGIN; `nuxt generate` reads from NUXT_PUBLIC_WP_API_BASE.
NUXT_DEV_WP_ORIGIN=https://progressnow.test:8890
NUXT_PUBLIC_WP_API_BASE=https://progressnow.test:8890/wp-json/progressnow/v1
# Set by the rebuild workflow from the dispatch payload (inc/rebuild.php).
CHAPTER_CONTENT_VERSION=
# Fixture-backed nitro mock instead of a live WordPress (CI / smoke builds).
# NUXT_MOCK_API=1
# Local self-signed MAMP certificate: trust MAMP's CA from the shell before
# starting Node (README § Local TLS) —
#   NODE_EXTRA_CA_CERTS=/Applications/MAMP/Library/OpenSSL/certs/MAMP_PRO_Root_CA.crt
# It is read at process start, so it cannot live in this file. Never set
# NODE_TLS_REJECT_UNAUTHORIZED=0: it disables verification outright.

