{% extends "base.twig" %}

{#
  Single post — openspec progress-now-v4-blog. The SinglePost island renders
  the v4 hero (PageHeader `post` variant), the article column with the
  pulled-up featured image, the sticky sidebar and "Read next".
  inc/blog.php always sets single_post / single_posts / single_categories for
  post-type posts. The server-rendered article inside the mount element is the
  crawlable/no-JS fallback — same class recipes as SinglePost.vue —
  createApp().mount() replaces it on hydration. Non-post singles (e.g. events)
  render their editor content. Comments are out of the design's scope.
#}

{% block content %}
	{% if single_post is defined %}
		{% set post_props = {
			post: single_post,
			posts: single_posts,
			categories: single_categories,
			showMetaRail: single_show_meta_rail,
			blogUrl: single_blog_url,
			homeUrl: single_home_url,
			joinUrl: chapter.join_url,
			joinLabel: pll__('Join Now'),
			ctaTitle: pll__('Get involved'),
			ctaBody: pll__('Meetings, actions and committees are open to everyone. Come find your place in the work.'),
			crumbHome: pll__('Home'),
			crumbBlog: pll__('Blog'),
			onThisPageLabel: pll__('On this page'),
			shareLabel: pll__('Share'),
			copyLabel: pll__('Copy link'),
			emailLabel: pll__('Email it'),
			readNextLabel: pll__('Read next'),
			allPostsLabel: pll__('All posts')
		} %}
		{% set cat_labels = {} %}
		{% for c in single_categories %}
			{% set cat_labels = cat_labels|merge({ (c.id): c.label }) %}
		{% endfor %}
		{% set has_image = single_post.featuredImage.src|default('') != '' %}
		{% set is_named = single_post.bylineMode != 'committee' %}
		{% set author_name = is_named ? single_post.author : (single_post.committee ? 'The ' ~ single_post.committee : '') %}
		{% set initials = '' %}
		{% for w in (is_named ? single_post.author : single_post.committee)|split(' ') %}
			{% if w and w != 'Committee' and initials|length < 2 %}{% set initials = initials ~ w[:1]|upper %}{% endif %}
		{% endfor %}

		<div data-vue-island="SinglePost" data-props='{{ post_props|json_encode|e("html_attr") }}'>
			{# Hero — partials/page-header.twig `post` variant (PageHeader.vue twin) #}
			{% set byline %}
				<div class="flex flex-wrap items-center gap-2.5 text-[0.9rem] font-semibold md:gap-3.5 md:text-base">
					{% if initials %}<span aria-hidden="true" class="inline-flex size-[38px] items-center justify-center rounded-full bg-brand-light text-[0.85rem] font-extrabold text-brand-deep md:size-11 md:text-base">{{ initials }}</span>{% endif %}
					{% if author_name %}
						<span>By {{ author_name }}</span>
						<span aria-hidden="true">·</span>
					{% endif %}
					<span>{{ single_post.date }}<span class="md:hidden"> · {{ single_post.readMinutes }} min</span></span>
					<span aria-hidden="true" class="hidden md:inline">·</span>
					<span class="hidden md:inline">{{ single_post.readMinutes }} min read</span>
				</div>
			{% endset %}
			{% set category_pill %}
				<a href="{{ single_blog_url }}?category={{ single_post.cat }}" class="category-tag inline-block self-start rounded-full bg-white px-3.5 py-[5px] text-[0.78rem] font-bold uppercase tracking-[0.06em] text-brand no-underline hover:underline hover:underline-offset-4">{{ cat_labels[single_post.cat]|default(single_post.cat) }}</a>
			{% endset %}
			{% include 'partials/page-header.twig' with {
				title: single_post.title,
				variant: 'post',
				pull_up: has_image,
				crumbs: [{ label: pll__('Home'), href: single_home_url }, { label: pll__('Blog'), href: single_blog_url }],
				extra_before: category_pill,
				extra: byline
			} only %}

			<section class="bg-white px-6 pb-12 md:pb-20" data-tone="white">
				<div class="mx-auto grid max-w-[1140px] items-start gap-10 lg:gap-14 {{ single_show_meta_rail ? 'lg:[grid-template-columns:minmax(300px,1fr)_280px]' : 'lg:[grid-template-columns:minmax(300px,880px)] lg:justify-center' }}">
					<article class="flex min-w-0 flex-col gap-[18px] md:gap-6 {{ has_image ? '' : 'pt-8' }}">
						{% if has_image %}
							<figure class="m-0 -mt-[70px] flex flex-col md:-mt-[110px]">
								<div class="aspect-video overflow-hidden rounded-[16px] bg-white shadow-photo md:rounded-[24px]">
									{% include 'partials/duotone.twig' with { image: single_post.featuredImage, opacity: 0.25, class: 'size-full', img_class: 'block size-full object-cover', fetchpriority: 'high' } only %}
								</div>
								{% if single_post.featuredImage.caption|default('') or single_post.featuredImage.credit|default('') %}
									<figcaption class="mt-3 text-[0.9rem] leading-[1.5] text-muted">{{ single_post.featuredImage.caption|default('') }} {{ single_post.featuredImage.credit|default('') }}</figcaption>
								{% endif %}
							</figure>
						{% endif %}
						{% if single_post.dek %}
							<p class="m-0 mt-1.5 text-[1.08rem] font-semibold leading-[1.6] text-ink md:mt-2 md:text-[1.22rem] md:leading-[1.65]">{{ single_post.dek }}</p>
						{% endif %}
						{# Prose HTML is kses-sanitized at serialize time (inc/blog.php). #}
						{% for block in single_post.blocks %}
							{% if block.type == 'prose' %}
								<div class="block-prose prose-chapter prose-post w-full">{{ block.html|raw }}</div>
							{% elseif block.type == 'pull_quote' %}
								<aside class="block-pull-quote flex w-full flex-col gap-2.5 rounded-[16px] border-l-[5px] border-brand bg-alt px-[22px] py-5 md:gap-3 md:rounded-[20px] md:border-l-[6px] md:px-[30px] md:py-[26px]">
									<blockquote class="m-0 font-display text-[1.05rem] font-normal leading-[1.4] text-ink md:text-[1.25rem] md:leading-[1.35]">{{ block.quote }}</blockquote>
									{% if block.attribution %}<div class="text-[0.88rem] font-bold text-brand md:text-[0.95rem]">— {{ block.attribution }}</div>{% endif %}
								</aside>
							{% elseif block.type == 'image' and block.image.src|default('') %}
								<figure class="block-image m-0 flex w-full flex-col">
									<div class="h-[clamp(240px,38vw,440px)] overflow-hidden rounded-[20px] bg-white">
										{% include 'partials/duotone.twig' with { image: block.image, opacity: 0.25, class: 'size-full', img_class: 'block size-full object-cover', loading: 'lazy' } only %}
									</div>
									{% if block.image.caption|default('') or block.image.credit|default('') %}
										<figcaption class="pt-3 text-[0.9rem] leading-[1.5] text-muted">{{ block.image.caption|default('') }} {{ block.image.credit|default('') }}</figcaption>
									{% endif %}
								</figure>
							{% endif %}
						{% endfor %}
						<div class="mt-1.5 flex flex-wrap items-center gap-2.5 border-t border-line pt-5 md:mt-2 md:gap-3.5 md:pt-6">
							<span class="text-[0.85rem] font-extrabold uppercase tracking-[0.06em] text-muted md:text-[0.9rem]">{{ pll__('Share') }}</span>
							<a href="mailto:?subject={{ single_post.title|url_encode }}" class="rounded-full border-2 border-accent bg-transparent px-4 py-2 text-[0.85rem] font-bold text-accent no-underline transition-colors hover:bg-accent hover:text-white md:px-[18px] md:py-[7px] md:text-[0.9rem]">{{ pll__('Email it') }}</a>
						</div>
					</article>

					{% if single_show_meta_rail %}
						<aside aria-label="Post details" class="flex flex-col gap-6 lg:sticky lg:top-[calc(108px+var(--wp-admin--admin-bar--height,0px))] lg:pt-8">
							{% if chapter.join_url %}
								{% include 'partials/cta-card.twig' with { title: pll__('Get involved'), body: pll__('Meetings, actions and committees are open to everyone. Come find your place in the work.'), href: chapter.join_url, label: pll__('Join Now'), external: true } only %}
							{% endif %}
						</aside>
					{% endif %}
				</div>
			</section>

			{% if single_posts|length %}
				<section class="bg-alt px-6 pb-14 pt-11 md:pb-24 md:pt-16" data-tone="alt">
					<div class="mx-auto flex max-w-[1140px] flex-col gap-[18px] md:gap-7">
						<div class="flex flex-wrap items-baseline justify-between gap-4">
							<h2 class="m-0 font-display text-[1.35rem] font-normal leading-[1.2] md:text-[clamp(1.6rem,2.8vw,2.2rem)] md:leading-[1.1]">{{ pll__('Read next') }}</h2>
							<a href="{{ single_blog_url }}" class="hidden items-center gap-4 text-[1.05rem] font-extrabold uppercase tracking-[0.03em] text-accent no-underline hover:underline hover:underline-offset-4 md:flex">{{ pll__('All posts') }} {% include 'partials/arrow.twig' with { class: 'h-5 w-10 flex-none fill-accent' } only %}</a>
						</div>
						<div class="flex flex-col gap-3 md:grid md:gap-6 md:[grid-template-columns:repeat(auto-fit,minmax(260px,1fr))]">
							{% for p in single_posts|slice(0, 3) %}
								<a href="{{ p.url }}" class="post-card grid overflow-hidden rounded-[16px] bg-white text-ink no-underline shadow-card transition-[box-shadow,transform] duration-150 [grid-template-columns:96px_1fr] hover:-translate-y-0.5 hover:shadow-card-hover-lg md:flex md:flex-1 md:flex-col md:rounded-[20px]">
									<span class="relative block min-h-[96px] overflow-hidden md:aspect-video md:min-h-0" aria-hidden="true">
										{% if p.image.src|default('') %}
											{% include 'partials/duotone.twig' with { image: p.image, opacity: 0, class: 'absolute inset-0 size-full', img_class: 'block size-full object-cover', loading: 'lazy' } only %}
										{% else %}
											<span class="absolute inset-0 bg-[repeating-linear-gradient(45deg,var(--color-alt)_0_14px,var(--color-control-faint)_14px_28px)]"></span>
										{% endif %}
									</span>
									<span class="flex flex-col justify-center gap-[5px] px-4 py-3 md:justify-start md:gap-2 md:px-[22px] md:pb-6 md:pt-5">
										<span class="text-[0.72rem] font-bold uppercase tracking-[0.06em] text-brand md:text-[0.78rem]">{{ cat_labels[p.cat]|default(p.cat) }}</span>
										<span class="text-[0.95rem] font-bold leading-[1.3] md:text-[1.05rem] md:font-extrabold">{{ p.title }}</span>
										<span class="text-[0.8rem] font-semibold text-muted md:text-[0.85rem]">{{ p.date }}</span>
									</span>
								</a>
							{% endfor %}
						</div>
						<a href="{{ single_blog_url }}" class="flex items-center justify-center gap-3.5 text-[0.95rem] font-extrabold uppercase tracking-[0.03em] text-accent no-underline hover:underline hover:underline-offset-4 md:hidden">{{ pll__('All posts') }} {% include 'partials/arrow.twig' with { class: 'h-[17px] w-[34px] flex-none fill-accent' } only %}</a>
					</div>
				</section>
			{% endif %}
		</div>
	{% else %}
		{# Non-post single (event permalink etc.): plain editor content. #}
		{% include 'partials/page-header.twig' with { title: function('html_entity_decode', post.title), crumbs: [{ label: pll__('Home'), href: home_url|default('/') }] } only %}
		<article class="mx-auto max-w-[880px] px-6 py-12">
			<div class="prose-chapter">{{ post.content }}</div>
		</article>
	{% endif %}
{% endblock %}
