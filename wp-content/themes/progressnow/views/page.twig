{% extends "base.twig" %}

{#
  Interior page template (default for all pages) — v4 interior layout
  (openspec progress-now-v4-interior-404 D1: header + article + sidebar).
  Twin of site/app/components/routes/RoutePage.vue — keep the class literals
  identical. documents / page_lede / grievance come from the "Interior page"
  ACF group (inc/interior.php); the fixture prose renders only when the WP
  editor content is empty.
#}

{# ---- shared interior recipes (same literals as page-about.twig) ---- #}
{% set h2class = 'm-0 scroll-mt-[calc(110px+var(--wp-admin--admin-bar--height,0px))] font-display text-[1.35rem] font-normal leading-[1.2] md:text-[1.6rem] md:leading-[1.15] xl:text-[clamp(1.6rem,2.6vw,2.2rem)] xl:leading-[1.1]' %}
{% set h2later = 'mt-3.5 xl:mt-[18px]' %}
{% set prose = 'text-[1.02rem] leading-[1.65] text-text-body md:text-[1.05rem] xl:text-[1.12rem] [&_p]:m-0 [&_p+p]:mt-4 [&_a]:font-bold [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-[3px] hover:[&_a]:text-brand-deep [&_ul]:my-0 [&_ul]:list-[square] [&_ul]:pl-5 [&_ol]:my-0 [&_ol]:list-decimal [&_ol]:pl-5 [&_strong]:font-extrabold [&_strong]:text-ink' %}
{% set callout = 'm-0 flex flex-col gap-2.5 rounded-[16px] border-l-[5px] border-brand bg-alt px-[22px] py-5 md:rounded-[18px] md:px-[26px] md:py-[22px] xl:rounded-[20px] xl:border-l-[6px] xl:px-[30px] xl:py-[26px]' %}

{# documents comes from inc/interior.php — always set (possibly empty). #}
{% set documents = documents|default([]) %}

{% block content %}
	{# Server-rendered header band (partials/page-header.twig — the PageHeader.vue twin). #}
	{% include 'partials/page-header.twig' with {
		title: function('html_entity_decode', post.title),
		lede: page_lede|default(post.post_excerpt|default(post.content ? '' : 'How our chapter governs itself — and how we take care of each other while we do the work.')),
		crumbs: [{ label: pll__('Home'), href: home_url|default('/') }]
	} only %}

	<section class="interior-page bg-white px-6 pb-14 pt-11 md:px-10 md:pb-[72px] md:pt-14 xl:px-6 xl:pb-24 xl:pt-16" data-tone="white">
		<div class="mx-auto grid max-w-[1140px] items-start gap-10 md:gap-9 md:[grid-template-columns:minmax(0,1fr)_260px] xl:gap-14 xl:[grid-template-columns:minmax(300px,1fr)_310px]">

			<article id="post-{{ post.ID }}" class="post-type-{{ post.post_type }} flex min-w-0 flex-col gap-5 md:gap-[22px] xl:gap-[26px]">

				{% if post.content %}
					<div class="prose-chapter">{{ post.content }}</div>
				{% else %}
					<p class="m-0 {{ prose }}">Our chapter is governed by its members. These documents spell out how we make decisions together, how we treat each other, and what to do when something goes wrong. Every member is encouraged to read them &mdash; and every member has the power to propose changes.</p>

					{# ---- Code of conduct (fixture) ---- #}
					<h2 id="conduct" class="{{ h2class }} {{ h2later }}">What we expect of each other</h2>
					<p class="m-0 {{ prose }}">Organizing only works when everyone can participate safely and fully. Our code of conduct applies to all chapter spaces &mdash; meetings, actions, socials, and online channels. In short:</p>
					<ul class="m-0 flex list-[square] flex-col gap-2.5 pl-6 text-[1.02rem] leading-[1.6] text-text-body marker:text-brand md:text-[1.05rem] xl:text-[1.12rem]">
						<li>Treat fellow members with respect, across every difference.</li>
						<li>Honor pronouns, access needs, and language needs.</li>
						<li>No harassment, intimidation, or discrimination &mdash; full stop.</li>
						<li>Disagree openly and in good faith; debate ideas, not people.</li>
					</ul>
					<h3 class="mx-0 mb-0 mt-2 font-display text-[1.15rem] font-normal leading-[1.2]">Amending these documents</h3>
					<p class="m-0 {{ prose }}">Any member in good standing may propose an amendment. Proposals are read at a general meeting and voted on at the following one. Reach out to the steering committee if you&rsquo;d like help drafting a proposal.</p>
				{% endif %}

				{# ---- Grievance callout (toggle + editable body; email from chapter settings) ---- #}
				{% if show_grievance|default(true) %}
					<aside id="grievance" class="callout-card mt-1.5 scroll-mt-[calc(110px+var(--wp-admin--admin-bar--height,0px))] {{ callout }}">
						<div class="font-display text-base font-normal text-brand md:text-[1.05rem]">{{ pll__('Need to report something?') }}</div>
						{% if grievance_body|default('') %}
							<div class="prose-chapter text-base leading-[1.65] text-text-body">{{ grievance_body|raw }}</div>
						{% else %}
							<p class="m-0 text-base leading-[1.65] text-text-body">Our grievance officers are here for you. Reports are handled confidentially, and you can always bring a support person.{% if chapter.contact_email %} Email <a href="mailto:{{ chapter.contact_email }}" class="notranslate font-bold text-accent underline underline-offset-[3px] hover:text-brand-deep">{{ chapter.contact_email }}</a> or speak to any grievance officer at a meeting.{% else %} Speak to any grievance officer at a meeting.{% endif %}</p>
						{% endif %}
					</aside>
				{% endif %}

			</article>

			{# ---- Sidebar: Get involved · Documents · Related · Contact ---- #}
			<aside aria-label="{{ pll__('Related') }}" class="flex flex-col gap-5 md:sticky md:top-[calc(120px+var(--wp-admin--admin-bar--height,0px))] xl:top-[calc(108px+var(--wp-admin--admin-bar--height,0px))] xl:gap-6">
				{% if newhere %}
					{% include 'partials/cta-card.twig' with { id: 'involved', title: newhere.heading, body: newhere.body, href: newhere.url, label: newhere.link_label, external: newhere.external|default(false) } only %}
				{% endif %}

				{% if documents|length %}
					{% include 'partials/link-list-card.twig' with { id: 'documents', heading: pll__('Documents'), links: documents|map(d => { label: d.title, href: d.url }) } only %}
				{% endif %}

				{% include 'partials/link-list-card.twig' with { heading: pll__('Related'), links: [
					{ label: pll__('Mission & History'), href: localize_url('/about/#mission') },
					{ label: pll__('Committees'), href: localize_url('/get-involved/#committees') },
					{ label: pll__('FAQ'), href: localize_url('/about/#faq') }
				] } only %}

				{% if chapter.contact_email %}
					{% include 'partials/dashed-note.twig' with { id: 'contact', heading: pll__('Contact'), body: '<p>' ~ pll__('Questions, ideas, or press —') ~ ' <a class="notranslate" href="mailto:' ~ chapter.contact_email ~ '">' ~ chapter.contact_email ~ '</a></p>' } only %}
				{% endif %}
			</aside>

		</div>
	</section>

	{% include 'partials/subscribe-strip.twig' with { href: chapter.newsletter_url, title: pll__('Never miss an update'), lede: pll__('One email when something new lands — meetings, actions, and posts. No spam, ever.'), label: pll__('Subscribe') } only %}
{% endblock %}
