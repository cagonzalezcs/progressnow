<!doctype html>
<!--[if lt IE 9]><html class="no-js no-svg ie lt-ie9 lt-ie8 lt-ie7" {{ site.language_attributes }}{{ html_data_attrs|default('')|raw }}> <![endif]-->
<!--[if IE 9]><html class="no-js no-svg ie ie9 lt-ie9 lt-ie8" {{ site.language_attributes }}{{ html_data_attrs|default('')|raw }}> <![endif]-->
<!--[if gt IE 9]><!--><html class="no-js no-svg" {{ site.language_attributes }}{{ html_data_attrs|default('')|raw }}> <!--<![endif]-->
<head>
    <meta charset="{{ site.charset }}" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {# REST base + page language for the client navigation layer's JSON fast-path (ts/navigation.ts). #}
    <meta name="progressnow:api-base" content="{{ function('rest_url', 'progressnow/v1') }}">
    <meta name="progressnow:lang" content="{{ current_language }}">
    <link rel="author" href="{{ site.theme.link }}/humans.txt" />
    <link rel="pingback" href="{{ site.pingback_url }}" />
    <link rel="profile" href="http://gmpg.org/xfn/11">
    <style>
      /* Critical: paint the white page ground before Tailwind/JS loads so navigations
         never flash browser-white. Mirrors --background in src/css/tailwind.css. */
      html { background-color: #FFFFFF; }
      /* Cross-document view transitions: full-page loads (logged-in users bypass
         the ts/navigation.ts SPA layer) cross-fade instead of hard-flashing.
         Inline so the opt-in is parsed pre-render in dev and prod alike. */
      @media not (prefers-reduced-motion: reduce) {
        @view-transition { navigation: auto; }
      }
      /* Unique names lift the fixed chrome out of the root cross-fade — identical
         pixels on both pages, so these hold still instead of fading. The header is
         a client-mounted island: if it hasn't mounted when the transition starts,
         its group falls back to the plain cross-fade (never worse). */
      #wpadminbar { view-transition-name: admin-bar; }
      .site-header { view-transition-name: site-header; }
      /* Subtler than the ~250ms default blink. */
      ::view-transition-old(root),
      ::view-transition-new(root) { animation-duration: 120ms; }
    </style>
    {{function('wp_head')}}