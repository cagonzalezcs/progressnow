{% extends "base.twig" %}

{#
  Blog archive (posts page) — openspec progress-now-v4-blog. One BlogArchive
  island serves browse, category filter, and search states; index/category/
  search templates all land here. inc/blog.php always sets archive_posts /
  archive_total / archive_categories / archive_pagination / archive_api_base;
  the island fetches interaction states from /progressnow/v1/posts and owns
  the designed empty state. The markup inside the mount is the crawlable,
  no-JS first paint (same class recipes as the island's browse mode — keep
  them in step with BlogArchive.vue / PostCard.vue / FeaturedPostCard.vue).
#}

{% block content %}
	{# archive.twig / search.twig override page_header_props with the computed context title. #}
	{% set page_header_props = page_header_props|default({
		title: posts_page_title|default(pll__('From the blog')),
		lede: posts_page_lede|default('News, analysis, and dispatches from chapter organizers across ' ~ chapter.region_label ~ '.'),
		crumbs: [{ label: pll__('Home'), href: home_url|default('/') }],
		wide: true
	}) %}
	{% include 'partials/page-header.twig' with page_header_props only %}

	{% set archive_props = {
		initialPosts: archive_posts,
		initialTotal: archive_total,
		categories: archive_categories,
		pagination: archive_pagination,
		apiBase: archive_api_base,
		lang: current_language,
		showSubscribe: true,
		newsletterUrl: chapter.newsletter_url,
		subscribeTitle: pll__('Never miss a post'),
		subscribeLede: pll__('One email when we publish. No spam, no lists sold — ever.'),
		subscribeLabel: pll__('Subscribe')
	} %}
	{% set cat_labels = {} %}
	{% for c in archive_categories %}
		{% set cat_labels = cat_labels|merge({ (c.id): c.label }) %}
	{% endfor %}

	<div data-vue-island="BlogArchive" data-props='{{ archive_props|json_encode|e("html_attr") }}'>
		{# Toolbar (static twin: chips are links to the category archives, the search is a real GET form) #}
		<section class="bg-white px-6 pt-7 md:pt-10" data-tone="white">
			<div class="mx-auto flex max-w-[1200px] flex-col gap-3.5 md:flex-row md:flex-wrap md:items-center md:justify-between md:gap-4">
				<form role="search" method="get" action="{{ home_url|default('/') }}" class="order-first contents md:order-last md:block">
					<input type="search" name="s" placeholder="Search posts…" aria-label="Search posts" value="{{ search_query|default('') }}" class="order-first box-border w-full rounded-full border-2 border-control bg-white px-5 py-3 text-base font-medium text-ink outline-offset-2 md:order-last md:w-auto md:min-w-[240px] md:py-2.5">
				</form>
				<div role="group" aria-label="Filter by category" class="flex flex-wrap items-center gap-2">
					{% for c in archive_categories %}
						{% set active = (c.id == 'all' and not archive_category|default('')) or c.id == archive_category|default('') %}
						<a href="{{ c.id == 'all' ? posts_page_url|default('/blog/') : (posts_page_url|default('/blog/') ~ '?category=' ~ c.id) }}" aria-current="{{ active ? 'true' : 'false' }}" class="rounded-full border-2 px-[18px] py-2 text-[0.88rem] font-bold no-underline transition-colors {{ active ? 'border-brand bg-brand text-white' : 'border-control bg-white text-ink hover:border-brand-deep hover:bg-brand-deep hover:text-white' }}">{{ c.label }}</a>
					{% endfor %}
				</div>
			</div>
		</section>

		{% if archive_posts|length %}
			{% set featured = archive_posts|first %}
			<section class="bg-white px-6 pt-6 md:pt-8" data-tone="white">
				<div class="mx-auto max-w-[1200px]">
					<a href="{{ featured.url }}" class="featured-post-card grid overflow-hidden rounded-[18px] bg-white text-ink no-underline shadow-featured transition-[box-shadow,transform] duration-150 hover:-translate-y-0.5 hover:shadow-card-hover-lg lg:rounded-[24px] lg:[grid-template-columns:minmax(300px,1.2fr)_minmax(280px,1fr)]">
						<span class="relative block aspect-video overflow-hidden lg:aspect-auto lg:min-h-[300px]">
							{% if featured.image.src|default('') %}
								{% include 'partials/duotone.twig' with { image: featured.image, opacity: 0.3, class: 'absolute inset-0 size-full', img_class: 'block size-full object-cover' } only %}
							{% else %}
								<span aria-hidden="true" class="absolute inset-0 bg-[repeating-linear-gradient(45deg,var(--color-alt)_0_14px,var(--color-control-faint)_14px_28px)]"></span>
							{% endif %}
							<span class="absolute left-3 top-3 rounded-full bg-brand px-3 py-1 text-[0.72rem] font-bold uppercase tracking-[0.06em] text-white lg:left-4 lg:top-4 lg:px-3.5 lg:py-[5px] lg:text-[0.75rem]">{{ pll__('Featured') }}</span>
						</span>
						<span class="flex flex-col justify-center gap-2 px-5 pb-[22px] pt-[18px] lg:gap-3 lg:px-10 lg:py-9">
							<span class="text-[0.82rem] font-semibold text-muted lg:text-[0.85rem]">{{ featured.date }}{% if featured.readMinutes %} · {{ featured.readMinutes }} min read{% endif %}</span>
							<span class="font-display text-[1.15rem] leading-[1.25] [text-wrap:balance] lg:text-[clamp(1.3rem,2.4vw,1.7rem)] lg:leading-[1.2]">{{ featured.title }}</span>
							<span class="text-[0.95rem] leading-[1.55] text-muted lg:text-[1.05rem] lg:leading-[1.6]">{{ featured.dek|default(featured.excerpt) }}</span>
							<span class="mt-1 hidden items-center gap-3 text-[0.95rem] font-extrabold uppercase tracking-[0.03em] text-accent lg:flex">{{ pll__('Read the post') }} {% include 'partials/arrow.twig' with { class: 'h-4 w-8 flex-none fill-accent' } only %}</span>
						</span>
					</a>
				</div>
			</section>

			<section class="bg-white px-6 pb-14 pt-6 md:pb-[72px] md:pt-10" data-tone="white">
				<div class="mx-auto flex max-w-[1200px] flex-col">
					<div class="flex flex-col gap-3 md:grid md:gap-7 md:[grid-template-columns:repeat(auto-fill,minmax(300px,1fr))]">
						{% for p in archive_posts|slice(1) %}
							<a href="{{ p.url }}" class="post-card grid overflow-hidden rounded-[16px] bg-white text-ink no-underline shadow-card transition-[box-shadow,transform] duration-150 [grid-template-columns:96px_1fr] hover:-translate-y-0.5 hover:shadow-card-hover-lg md:flex md:flex-1 md:flex-col md:rounded-[24px]">
								<span class="relative block min-h-[96px] overflow-hidden md:aspect-video md:min-h-0" aria-hidden="true">
									{% if p.image.src|default('') %}
										{% include 'partials/duotone.twig' with { image: p.image, opacity: 0, class: 'absolute inset-0 size-full', img_class: 'block size-full object-cover', loading: 'lazy' } only %}
									{% else %}
										<span class="absolute inset-0 bg-[repeating-linear-gradient(45deg,var(--color-alt)_0_14px,var(--color-control-faint)_14px_28px)]"></span>
									{% endif %}
									<span class="absolute left-3 top-3 hidden rounded-full bg-white px-3 py-1 text-[0.72rem] font-bold uppercase tracking-[0.06em] text-brand md:inline-block">{{ cat_labels[p.cat]|default(p.cat) }}</span>
								</span>
								<span class="flex flex-col justify-center gap-[5px] px-4 py-3 md:justify-start md:gap-2 md:px-6 md:pb-[26px] md:pt-[22px]">
									<span class="text-[0.72rem] font-bold uppercase tracking-[0.06em] text-brand md:hidden">{{ cat_labels[p.cat]|default(p.cat) }}</span>
									<span class="text-[0.95rem] font-bold leading-[1.3] md:text-[1.12rem] md:font-extrabold">{{ p.title }}</span>
									<span class="text-[0.8rem] font-semibold text-muted md:order-first md:text-[0.85rem]"><span class="md:hidden">{{ p.date }}</span><span class="hidden md:inline">{{ p.date }}{% if p.readMinutes %} · {{ p.readMinutes }} min read{% endif %}</span></span>
									{% if p.excerpt %}<span class="hidden text-[0.98rem] leading-[1.55] text-muted md:block">{{ p.excerpt }}</span>{% endif %}
								</span>
							</a>
						{% endfor %}
					</div>
					{% if archive_pagination and (archive_pagination.newerUrl or archive_pagination.olderUrl) %}
						<nav aria-label="Pagination" class="flex flex-wrap items-center justify-center gap-2 pt-7 md:gap-2.5 md:pt-12">
							{% if archive_pagination.newerUrl %}
								<a href="{{ archive_pagination.newerUrl }}" class="inline-flex h-11 min-w-11 items-center justify-center rounded-full border-2 border-control bg-white px-[18px] text-[0.95rem] font-extrabold text-ink no-underline transition-colors hover:border-brand-deep hover:bg-brand-deep hover:text-white"><span aria-hidden="true">←</span><span class="hidden md:inline">&nbsp;Prev</span><span class="sr-only">Previous page</span></a>
							{% else %}
								<span aria-disabled="true" class="inline-flex h-11 min-w-11 items-center justify-center rounded-full border-2 border-control-faint bg-white px-[18px] text-[0.95rem] font-extrabold text-border-muted"><span aria-hidden="true">←</span><span class="hidden md:inline">&nbsp;Prev</span></span>
							{% endif %}
							{% if archive_pagination.olderUrl %}
								<a href="{{ archive_pagination.olderUrl }}" class="inline-flex h-11 min-w-11 items-center justify-center rounded-full border-2 border-control bg-white px-[18px] text-[0.95rem] font-extrabold text-ink no-underline transition-colors hover:border-brand-deep hover:bg-brand-deep hover:text-white"><span class="hidden md:inline">Next&nbsp;</span><span aria-hidden="true">→</span><span class="sr-only">Next page</span></a>
							{% else %}
								<span aria-disabled="true" class="inline-flex h-11 min-w-11 items-center justify-center rounded-full border-2 border-control-faint bg-white px-[18px] text-[0.95rem] font-extrabold text-border-muted"><span class="hidden md:inline">Next&nbsp;</span><span aria-hidden="true">→</span></span>
							{% endif %}
						</nav>
					{% endif %}
				</div>
			</section>
		{% else %}
			<section class="bg-white px-6 pb-14 pt-6 md:pb-[72px] md:pt-8" data-tone="white">
				<div class="mx-auto max-w-[1200px]">
					<div class="flex flex-col items-center gap-1 rounded-[16px] border-2 border-dashed border-border-muted px-6 py-11 text-center md:rounded-[20px] md:px-8 md:py-14">
						<div class="text-[1.05rem] font-extrabold md:text-[1.2rem] md:font-bold">{{ pll__('No posts yet') }}</div>
						<p class="m-0 max-w-[42ch] text-base leading-[1.45] md:text-[1.1rem]">{{ pll__('The chapter blog is warming up. Check back soon.') }}</p>
					</div>
				</div>
			</section>
		{% endif %}

		{% include 'partials/subscribe-strip.twig' with { href: chapter.newsletter_url, title: pll__('Never miss a post'), lede: pll__('One email when we publish. No spam, no lists sold — ever.'), label: pll__('Subscribe') } only %}
	</div>
{% endblock %}
