<?xml version="1.0"?>
<ruleset name="Progress Now — security sniffs">
	<description>
		Security-only WordPress Coding Standards gate over the custom theme
		(openspec security-headers-and-cicd-gates § SAST). Deliberately not the
		full WordPress-Extra style ruleset: this gate exists to fail CI on the
		classes of defect the security audit found — unescaped output,
		unsanitized input, missing nonce checks, unprepared SQL, dangerous PHP
		functions — not on whitespace. `composer lint` locally; the `php-sast`
		job in .github/workflows/ci.yml in CI.
	</description>

	<file>.</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/wordpress/*</exclude-pattern>
	<exclude-pattern>*/dist/*</exclude-pattern>
	<!-- Tests echo fixtures and read superglobals by design; the suite is not a sink. -->
	<exclude-pattern>*/tests/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<config name="minimum_wp_version" value="6.5"/>

	<!-- Output escaping, input sanitization, nonce verification, safe redirects, menu slugs. -->
	<rule ref="WordPress.Security">
		<!-- Unslashing is a correctness nicety, not a security boundary; the
		     sanitization half of the sniff stays on. -->
		<exclude name="WordPress.Security.ValidatedSanitizedInput.MissingUnslash"/>
	</rule>
	<rule ref="WordPress.Security.EscapeOutput">
		<properties>
			<!-- The one script-context encoder (inc/escaping.php): its output is
			     already safe inside a <script> element. -->
			<property name="customAutoEscapedFunctions" type="array">
				<element value="progressnow_json_for_script"/>
			</property>
		</properties>
	</rule>

	<!-- SQL must be prepared. -->
	<rule ref="WordPress.DB.PreparedSQL"/>
	<rule ref="WordPress.DB.PreparedSQLPlaceholders"/>

	<!-- eval/system/serialize/runtime-config families. base64 is legitimate here
	     (the CSP nonce), so the obfuscation group is not part of the gate. -->
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions">
		<properties>
			<property name="exclude" type="array">
				<element value="obfuscation"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.PHP.DevelopmentFunctions.prevent_path_disclosure"/>
	<rule ref="Generic.PHP.ForbiddenFunctions">
		<properties>
			<property name="forbiddenFunctions" type="array">
				<element key="eval" value="null"/>
				<element key="create_function" value="null"/>
				<element key="assert" value="null"/>
				<element key="extract" value="null"/>
				<element key="unserialize" value="maybe_unserialize"/>
			</property>
		</properties>
	</rule>
</ruleset>
