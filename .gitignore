# Wordpress - ignore core, configuration, examples, uploads and logs.
# https://github.com/github/gitignore/blob/main/WordPress.gitignore

# Core
#
# Note: if you want to stage/commit WP core files
# you can delete this whole section/until Configuration.
/wp-admin/
/wp-content/index.php
/wp-content/languages
/wp-content/plugins/index.php
/wp-content/themes/index.php
/wp-includes/
/index.php
/license.txt
/readme.html
/wp-*.php
/xmlrpc.php

# Configuration
wp-config.php

# Example themes
/wp-content/themes/twenty*/

# Example plugin
/wp-content/plugins/hello.php

# Uploads
/wp-content/uploads/

# Log files
*.log

# Backups / migration artifacts / upgrade temp
/wp-content/backups-dup-lite/
/wp-content/upgrade/
/wp-content/upgrade-temp-backup/
*.zip

# htaccess
/.htaccess

# Plugins are never vendored (ACF Pro + Polylang Pro are adopter-installed)
/wp-content/plugins/
/wp-content/mu-plugins/

# All themes
#
# Note: If you wish to whitelist themes,
# uncomment the next line
#/wp-content/themes

# System
.DS_Store
.idea/

# Local tooling / design reference (not versioned)
/.claude/
/wp-content/themes/design_handoff_vue/

# Worktree runtime symlinks (bin/worktree-bootstrap.sh) — the directory
# patterns above don't match symlinks.
/wp-admin
/wp-includes
/wp-content/uploads

# Nuxt build output
/site/dist/
/site/.output/
/site/.nuxt/
/site/node_modules/
/wp-content/themes/progressnow/node_modules/
/wp-content/themes/progressnow/vendor/
/wp-content/themes/progressnow/dist/
/wp-content/themes/progressnow/wordpress/

# Nuxt static rendition output synced to the docroot (CHAPTER_STATIC_DIR)
/static-site/

# Secrets
.env
/site/dist
