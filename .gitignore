# Wordpress - ignore core, configuration, examples, uploads and logs.
# https://github.com/github/gitignore/blob/main/WordPress.gitignore

# Core
#
# Note: if you want to stage/commit WP core files
# you can delete this whole section/until Configuration.
/wp-admin/
/wp-content/index.php
/wp-content/languages
/wp-content/plugins/index.php
/wp-content/themes/index.php
/wp-includes/
/index.php
/license.txt
/readme.html
/wp-*.php
/xmlrpc.php

# Configuration
wp-config.php

# Example themes
/wp-content/themes/twenty*/

# Example plugin
/wp-content/plugins/hello.php

# Uploads
/wp-content/uploads/

# Log files
*.log

# Backups / migration artifacts / upgrade temp — first line of defence only;
# .github/scripts/artifact-guard.sh is what fails CI and the deploy bundle.
**/backups-dup-*/
**/dup-installer/
**/installer*.php
/wp-content/upgrade/
/wp-content/upgrade-temp-backup/
*.zip
*.tar
*.tgz
*.tar.gz
*.sql
*.sql.gz

# htaccess
/.htaccess

# Plugins are never vendored: the root composer.json / dependency-pins.json pin
# them and `composer install` puts them here (docs/dependency-lifecycle.md)
/wp-content/plugins/
/wp-content/mu-plugins/

# Root Composer install: tooling, the pinned core download, and the licence
# credentials file — auth.json holds the ACF Pro key and is never committed
/vendor/
/.wp-core/
auth.json

# All themes
#
# Note: If you wish to whitelist themes,
# uncomment the next line
#/wp-content/themes

# System
.DS_Store
.idea/

# Local tooling / design reference (not versioned)
/.claude/
/wp-content/themes/design_handoff_vue/

# Worktree runtime symlinks (bin/worktree-bootstrap.sh) — the directory
# patterns above don't match symlinks.
/wp-admin
/wp-includes
/wp-content/uploads
/wp-content/plugins

# Nuxt build output
/nuxt-js/dist/
/nuxt-js/.output/
/nuxt-js/.nuxt/
/nuxt-js/node_modules/
/wp-content/themes/progressnow/node_modules/
/wp-content/themes/progressnow/vendor/
/wp-content/themes/progressnow/dist/
/wp-content/themes/progressnow/wordpress/

# Nuxt static rendition output synced to the docroot (CHAPTER_STATIC_DIR)
/static-site/

# Secrets
.env
/nuxt-js/dist

# Frontend
/node_modules/
.vercel
.env*

# Stale pre-rename Nuxt build output (site/ became nuxt-js/)
/site/
